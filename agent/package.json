{
  "name": "lionmatch-research-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Give it one objective. It designs a survey, sends it through Flashpoint, reads the results, runs a follow-up round, and writes the answer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "wallet": "node flashpoint.mjs wallet",
    "balance": "node flashpoint.mjs balance",
    "tools": "node flashpoint.mjs tools",
    "start": "node run.mjs",
    "mock": "node run.mjs --mock",
    "test": "node --test test/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@x402/evm": "^2.32.0",
    "@x402/fetch": "^2.32.0",
    "undici": "^8.13.1",
    "viem": "^2.58.4"
  }
}
