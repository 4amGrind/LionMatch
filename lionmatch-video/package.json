{
  "name": "lionmatch-video",
  "version": "1.0.0",
  "private": true,
  "description": "LionMatch launch film, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "capture": "node scripts/capture.mjs",
    "audio": "node scripts/make-audio.mjs",
    "render": "remotion render LionMatchFilm renders/lionmatch-demo.mp4 --scale=2",
    "render:draft": "remotion render LionMatchFilm renders/draft-1080.mp4 --crf=18 --x264-preset=veryfast",
    "render:all": "node scripts/render-all.mjs",
    "review": "node scripts/review.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "@remotion/media-utils": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.545",
    "@remotion/renderer": "^4.0.545",
    "@types/react": "^19",
    "ffmpeg-static": "^5.3.0",
    "playwright": "1.65.1",
    "potrace": "^2.1.8",
    "typescript": "^5"
  }
}
